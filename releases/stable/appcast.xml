        <item>
            <title>Trolley 1.9.0</title>
            <pubDate>Fri, 30 Oct 2026 11:24:47 +1100</pubDate>
            <sparkle:version>207</sparkle:version>
            <sparkle:shortVersionString>1.9.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<ul><li>A new Trolley workspace for Mac, with sidebar navigation, receipt import, in-app Settings, and a floating add-item card.</li><li>Compact windows, an animated overlay sidebar, whole-row editing, click-away dismissal, and clearer hover feedback.</li><li>Send a product photo to compare matching brands and variants from your receipts, even when your shopping list uses a general name.</li><li>Refreshed app icon, rounded typography, pastel aisles, and more reliable receipt imports.</li></ul>]]></description>
            <enclosure url="https://github.com/patbarlow/shopping-list/releases/download/v1.9.0/ShoppingList.dmg" sparkle:edSignature="xQ9PayjwM5f3V/3n5qrZxPU5MutPyrFsTXP6tO8nRvi5IO3vsBQzr54WfiI2pqWbz13WP2I5C7IC5ntpX2iqCg==" length="7406526" type="application/octet-stream"/>
        </item>
        <item>
            <title>1.8.0</title>
            <pubDate>Fri, 09 Oct 2026 15:55:17 +1100</pubDate>
            <sparkle:version>200</sparkle:version>
            <sparkle:shortVersionString>1.8.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<ul><li>Add several items at once with commas, “and”, or newlines.</li><li>Quantities such as “2 apples”, “220g butter”, and “chicken 700g” go into the quantity field.</li><li>Add items by voice with on-device speech recognition, a full-width glow at the bottom of the window, automatic adding after a pause, and brief Added/Undo feedback above the input.</li><li>Shopping-intent filtering helps keep unrelated conversation out of your list.</li></ul>]]></description>
            <enclosure url="https://github.com/patbarlow/shopping-list/releases/download/v1.8.0/ShoppingList.dmg" length="5235886" type="application/octet-stream" sparkle:edSignature="HHfbslJFQUhrjzGiDfzVSEByI2i1LUv5/LajAI7pUh3oT50YQCRnQ3x8XADkcDfhbWBTTFAZFoL7CYONPzj5Cw=="/>
        </item>
